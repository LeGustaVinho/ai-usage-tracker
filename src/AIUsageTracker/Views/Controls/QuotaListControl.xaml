<UserControl x:Class="AIUsageTracker.Views.Controls.QuotaListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Custom Rounded ProgressBar Style -->
        <Style x:Key="QuotaProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#33475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding QuotaBars}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,0,0,7"
                        Padding="9,7"
                        Background="#661E293B"
                        BorderBrush="#2694A3B8"
                        BorderThickness="1"
                        CornerRadius="8"
                        ToolTip="{Binding ToolTipText}">
                    <StackPanel>
                        <!-- Row 1: Badge + Title + Countdown + Percent -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Provider Pill Badge -->
                            <Border Grid.Column="0"
                                    Margin="0,0,6,0"
                                    Padding="5,1.5"
                                    VerticalAlignment="Center"
                                    Background="{Binding BadgeBrush}"
                                    CornerRadius="4">
                                <TextBlock FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{Binding ProviderBadge}" />
                            </Border>

                            <!-- Quota Title -->
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Reset Countdown -->
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,6,0"
                                       VerticalAlignment="Center"
                                       FontSize="10.5"
                                       Foreground="#94A3B8"
                                       Text="{Binding ResetCountdownText}"
                                       Visibility="{Binding HasResetCountdown, Converter={StaticResource BoolToVis}}" />

                            <!-- Percentage Value -->
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding StatusAccentBrush}"
                                       Text="{Binding DisplayPercentText}" />
                        </Grid>

                        <!-- Row 2: Progress Bar -->
                        <ProgressBar Style="{StaticResource QuotaProgressBarStyle}"
                                     Foreground="{Binding BarFillBrush}"
                                     Value="{Binding DisplayPercentValue, Mode=OneWay}" />

                        <!-- Row 3: Optional Subtitle -->
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="10"
                                   Foreground="#94A3B8"
                                   Text="{Binding Subtitle}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
