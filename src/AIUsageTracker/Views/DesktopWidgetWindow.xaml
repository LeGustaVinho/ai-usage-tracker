<Window x:Class="AIUsageTracker.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIUsageTracker.Views.Controls"
        Title="AI Usage Tracker HUD"
        Width="350"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="HudIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#3394A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Padding="12,10,12,6"
            Background="#F20F172A"
            BorderBrush="#4094A3B8"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="{Binding WidgetOpacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              Direction="270"
                              Opacity="0.45"
                              ShadowDepth="4"
                              Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- HUD Header Bar -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Mode Pill -->
                <StackPanel Grid.Column="0"
                             VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="#38BDF8" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#E2E8F0"
                               Text="AI QUOTA" />

                    <Button Margin="7,0,0,0"
                            Padding="6,2"
                            Command="{Binding ToggleDisplayModeCommand}"
                            Cursor="Hand"
                            ToolTip="Clique para alternar entre % Consumida e % Restante">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#2638BDF8"
                                        BorderBrush="#4D38BDF8"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1">
                                    <TextBlock FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#7DD3FC"
                                               Text="{Binding DisplayModeLabel}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right: Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource HudIconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="↻"
                            ToolTip="Atualizar cotas agora" />
                    <Button Style="{StaticResource HudIconButtonStyle}"
                            Command="{Binding ToggleCompactModeCommand}"
                            Content="▤"
                            ToolTip="Alternar Modo Compacto / Completo" />
                    <Button Style="{StaticResource HudIconButtonStyle}"
                            Command="{Binding ToggleClickThroughCommand}"
                            Content="👻"
                            ToolTip="Ativar Modo Click-Through (Atravessar cliques — desative pelo ícone da bandeja)" />
                    <Button Style="{StaticResource HudIconButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            Content="⚙"
                            ToolTip="Abrir Configurações" />
                    <Button Style="{StaticResource HudIconButtonStyle}"
                            Click="HideButton_Click"
                            Content="─"
                            ToolTip="Ocultar Widget do Desktop (continua na bandeja do sistema)" />
                </StackPanel>
            </Grid>

            <!-- Quota Bars List -->
            <controls:QuotaListControl />

            <!-- Footer Status -->
            <Grid Margin="0,1,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="9.5"
                           Foreground="#64748B"
                           Text="{Binding LastUpdatedText}" />
                <TextBlock Grid.Column="1"
                           FontSize="9.5"
                           Foreground="#64748B"
                           Text="Arraste para mover" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
