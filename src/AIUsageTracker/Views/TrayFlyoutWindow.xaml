<Window x:Class="AIUsageTracker.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIUsageTracker.Views.Controls"
        Title="AI Usage Tracker Flyout"
        Width="370"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlyoutActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#3394A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Padding="14,12"
            Background="#FA0F172A"
            BorderBrush="#4D94A3B8"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.55"
                              ShadowDepth="5"
                              Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- Flyout Header -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"
                               Text="AI Usage Tracker" />
                    <TextBlock FontSize="10.5"
                               Foreground="#94A3B8"
                               Text="{Binding LastUpdatedText}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource FlyoutActionButtonStyle}"
                            Command="{Binding ToggleDisplayModeCommand}"
                            Content="{Binding DisplayModeLabel}"
                            ToolTip="Alternar entre % Usada e % Restante" />
                    <Button Style="{StaticResource FlyoutActionButtonStyle}"
                            Margin="0"
                            Command="{Binding RefreshCommand}"
                            Content="↻ Atualizar" />
                </StackPanel>
            </Grid>

            <!-- Notice Banner when Click-Through is active -->
            <Border Margin="0,0,0,8"
                    Padding="8,6"
                    Background="#33F59E0B"
                    BorderBrush="#66F59E0B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding ClickThrough, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="#FDE68A"
                               Text="👻 Modo Click-Through ativo no Desktop" />
                    <Button Grid.Column="1"
                            Padding="6,2"
                            Background="#F59E0B"
                            Foreground="#0F172A"
                            FontWeight="Bold"
                            FontSize="10"
                            Command="{Binding ToggleClickThroughCommand}"
                            Content="Destravar" />
                </Grid>
            </Border>

            <!-- Quota Bars -->
            <controls:QuotaListControl />

            <!-- Bottom Actions Bar -->
            <Border Margin="0,6,0,0"
                    Padding="0,8,0,0"
                    BorderBrush="#2694A3B8"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource FlyoutActionButtonStyle}"
                            Click="ToggleDesktopWidget_Click"
                            Content="🖥 Desktop HUD"
                            ToolTip="Mostrar ou ocultar o Widget flutuante no Desktop" />

                    <Button Grid.Column="2"
                            Style="{StaticResource FlyoutActionButtonStyle}"
                            Click="OpenSettings_Click"
                            Content="⚙ Configurações" />

                    <Button Grid.Column="3"
                            Style="{StaticResource FlyoutActionButtonStyle}"
                            Margin="0"
                            Background="#33EF4444"
                            BorderBrush="#66EF4444"
                            Foreground="#FCA5A5"
                            Click="ExitApp_Click"
                            Content="Sair" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
